<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Version>0.16.0</Version>
    <AssemblyVersion>0.16.0.0</AssemblyVersion>
    <FileVersion>0.16.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Product>NRS Workbench</Product>
    <Authors>Neo RS</Authors>
    <Company>Neo RS</Company>
    <Copyright>Copyright © 2026 Neo RS</Copyright>
    <Description>Local developer control center for Git repositories and GitHub Actions self-hosted runners on Windows.</Description>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>