<Window x:Class="NRS.Workbench.App.CommitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Commit · NRS Workbench" Icon="/Assets/NRSWorkbench.ico"
        Width="1260" Height="800" MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="54" Height="54" CornerRadius="14" Background="#143A63" BorderBrush="#2F6FAF" BorderThickness="1">
                    <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="#7DBBFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Preparar commit" FontSize="27" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding RepositoryTitle}" Foreground="#6FADE8" FontWeight="SemiBold"/>
                        <TextBlock Text="  ·  " Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="{Binding BranchText}" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ToolbarButton}" Click="SelectAll_Click"><TextBlock Text="Seleccionar todo"/></Button>
                <Button Style="{StaticResource ToolbarButton}" Click="SelectNone_Click" Margin="0"><TextBlock Text="Ninguno"/></Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.82*"/><ColumnDefinition Width="1.18*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelCard}" Margin="0,0,7,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#122238" BorderBrush="#223A56" BorderThickness="0,0,0,1" Padding="13,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Archivos del commit" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedCount, StringFormat={}{0} seleccionados}" Foreground="{StaticResource MutedBrush}"/>
                        </Grid>
                    </Border>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Changes}" SelectedItem="{Binding SelectedChange, Mode=TwoWay}"
                             SelectionChanged="Changes_SelectionChanged" Background="#0B1624" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#122A43"/></Trigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#163754"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="11,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox">
                                                <Setter Property="IsEnabled" Value="True"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding IsConflict}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                    <Border Grid.Column="1" Padding="7,3" CornerRadius="8" BorderBrush="#34516D" BorderThickness="1" Background="#13283C" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="9.5" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding DisplayPath}" Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayPath}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding StatusCode}" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelCard}" Margin="7,0,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#122238" BorderBrush="#223A56" BorderThickness="0,0,0,1" Padding="13,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Diff" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Vista previa · no modifica archivos" Foreground="{StaticResource MutedBrush}"/>
                        </Grid>
                    </Border>
                    <TextBox Grid.Row="1" Text="{Binding DiffText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                             Background="#071321" Foreground="#DCEBFA" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                             Padding="13" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PanelCard}" Padding="15" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Mensaje de commit" FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <TextBox Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}" MinHeight="62" MaxHeight="110" Padding="10,8"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    <TextBlock Text="Se hará stage únicamente de los archivos seleccionados. Si existen archivos staged fuera de la selección, el commit se bloqueará por seguridad."
                               Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource ToolbarButton}" Click="Cancel_Click"><TextBlock Text="Cancelar"/></Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="Commit_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE73E;"/><TextBlock Text="Commit"/></StackPanel></Button>
                    <Button Style="{StaticResource PrimaryToolbarButton}" Click="CommitPush_Click" IsEnabled="{Binding CanPushAfterCommit}" Margin="0"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE898;"/><TextBlock Text="Commit &amp; Push"/></StackPanel></Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="2,10,2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="9" Height="9" Fill="#3DDC84" Margin="0,1,8,0"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="Neo RS" FontFamily="Segoe Script" FontSize="12" Foreground="#5EA7E8" Opacity="0.76"/>
        </Grid>
    </Grid>
</Window>
