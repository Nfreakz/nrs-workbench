<Window x:Class="NRS.Workbench.App.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NRS.Workbench.App.Services"
        Title="{local:Tr Source='Feedback y diagnóstico'}" Icon="/Assets/NRSWorkbench.ico"
        Width="860" Height="720" MinWidth="760" MinHeight="620" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Background="{StaticResource BgBrush}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{local:Tr Source='Feedback y diagnóstico'}" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="{local:Tr Source='Reporta problemas, propone mejoras y prepara un diagnóstico local antes de compartir nada.'}"
                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource PanelCard}" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="{local:Tr Source='Reportar problema'}" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{local:Tr Source='Abre la plantilla de bugs en GitHub. No se adjunta ningún archivo automáticamente.'}"
                               Style="{StaticResource MutedLabel}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                    <Button Content="{local:Tr Source='Abrir issue de problema'}" Style="{StaticResource ToolbarButton}"
                            HorizontalAlignment="Left" Margin="0" Click="ReportIssue_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="{local:Tr Source='Sugerir mejora'}" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{local:Tr Source='Abre la plantilla de mejoras en GitHub.'}"
                               Style="{StaticResource MutedLabel}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                    <Button Content="{local:Tr Source='Abrir propuesta de mejora'}" Style="{StaticResource ToolbarButton}"
                            HorizontalAlignment="Left" Margin="0" Click="SuggestFeature_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource PanelCard}" Padding="16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{local:Tr Source='Diagnóstico revisable'}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{local:Tr Source='El texto de abajo es exactamente el contenido principal que se guardará en el ZIP. Revísalo antes de compartirlo.'}"
                                   Style="{StaticResource MutedLabel}" TextWrapping="Wrap" Margin="0,4,16,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{local:Tr Source='Actualizar vista previa'}" Style="{StaticResource ToolbarButton}"
                            Margin="0" VerticalAlignment="Top" Click="RefreshPreview_Click"/>
                </Grid>
                <TextBlock x:Name="PreviewSummaryText" Grid.Row="1" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,10,0,8"/>
                <TextBox x:Name="PreviewText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11.5"
                         Background="#0E1013" Foreground="{StaticResource TextBrush}"
                         BorderBrush="#303640" BorderThickness="1" Padding="10"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{local:Tr Source='Nada se sube automáticamente. El ZIP se guarda solo donde tú elijas.'}"
                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{local:Tr Source='Copiar'}" Style="{StaticResource ToolbarButton}" Click="CopyPreview_Click"/>
                <Button Content="{local:Tr Source='Guardar ZIP...'}" Style="{StaticResource PrimaryToolbarButton}" Click="SaveBundle_Click"/>
                <Button Content="{local:Tr Source='Cerrar'}" Style="{StaticResource ToolbarButton}" Margin="8,0,0,0" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
