<Window x:Class="NRS.Workbench.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NRS.Workbench.App.Services"
        xmlns:conv="clr-namespace:NRS.Workbench.App.Converters"
        xmlns:models="clr-namespace:NRS.Workbench.Core.Models;assembly=NRS.Workbench.Core"
        Title="NRS Workbench" Icon="/Assets/NRSWorkbench.ico" Width="1580" Height="910" MinWidth="1240" MinHeight="760"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <!-- Fully templated ComboBox so Windows' light native chrome never leaks through. -->
        <Style x:Key="RunnerSortComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E7E9EC"/>
            <Setter Property="Background" Value="#1B1F24"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#252B33"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#2D3A4D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RunnerSortCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E7E9EC"/>
            <Setter Property="Background" Value="#1D2128"/>
            <Setter Property="BorderBrush" Value="#353B45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="11,6,34,6"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource RunnerSortComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboChrome"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <Grid>
                                                <TextBlock Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                           Foreground="#E7E9EC"
                                                           Margin="11,0,34,0"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           IsHitTestVisible="False"/>
                                                <Border Width="30" HorizontalAlignment="Right" Background="#1A1E23" CornerRadius="0,7,7,0"
                                                        IsHitTestVisible="False">
                                                    <TextBlock Text="⌄" Foreground="#9CA5B0" FontSize="18"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Margin="0,-4,0,0"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboChrome" Property="Background" Value="#252B33"/>
                                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="#505B69"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="#5B718F"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ComboChrome" Property="Opacity" Value="0.45"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Background="#1B1F24"
                                        BorderBrush="#424A55"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,0"
                                        MinWidth="150">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  MaxHeight="280"
                                                  CanContentScroll="True">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <conv:RunnerStateBrushConverter x:Key="StateBrush"/>
        <conv:RunnerStateAccentBrushConverter x:Key="StateAccentBrush"/>
        <conv:RunnerStateLabelConverter x:Key="StateLabel"/>
    </Window.Resources>

    <Grid Background="{StaticResource BgBrush}" Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="320"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="60" Height="60" CornerRadius="10" Background="#111419" BorderBrush="#4E6685" BorderThickness="1" ClipToBounds="True">
                    <Image Source="/Assets/NRSWorkbench.png" Stretch="Uniform" Margin="3"/>
                </Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="NRS Workbench" FontSize="27" FontWeight="Bold"/>
                        <Border Background="#28364B" BorderBrush="#4B5A6D" BorderThickness="1" CornerRadius="7" Padding="7,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppVersionText}" FontSize="11" Foreground="#D9DEE5" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{local:Tr Source='Runners y repositorios locales desde un solo sitio'}" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="1,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource StatCard}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" CornerRadius="7" Background="#2A3A52" VerticalAlignment="Center">
                            <TextBlock Text="&#xECA5;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#6F91C4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="RUNNERS" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding TotalCount}" FontSize="21" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Fill="#5AA878" Margin="0,1,11,0"/>
                        <StackPanel><TextBlock Text="READY" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding ReadyCount}" FontSize="21" FontWeight="Bold"/></StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Fill="#C59A4A" Margin="0,1,11,0"/>
                        <StackPanel><TextBlock Text="BUSY" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding BusyCount}" FontSize="21" FontWeight="Bold"/></StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Fill="#D2636D" Margin="0,1,11,0"/>
                        <StackPanel><TextBlock Text="STOPPED" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding StoppedCount}" FontSize="21" FontWeight="Bold"/></StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Margin="0,1,11,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#5AA878"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HealthKind}" Value="Warning"><Setter Property="Fill" Value="#C59A4A"/></DataTrigger>
                                        <DataTrigger Binding="{Binding HealthKind}" Value="Alert"><Setter Property="Fill" Value="#D2636D"/></DataTrigger>
                                        <DataTrigger Binding="{Binding HealthKind}" Value="Unknown"><Setter Property="Fill" Value="#8F97A1"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <StackPanel>
                            <TextBlock Text="{local:Tr Source='SALUD'}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding HealthLabel}" FontSize="16" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#67AF87"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HealthKind}" Value="Warning"><Setter Property="Foreground" Value="#C59A4A"/></DataTrigger>
                                            <DataTrigger Binding="{Binding HealthKind}" Value="Alert"><Setter Property="Foreground" Value="#D56B75"/></DataTrigger>
                                            <DataTrigger Binding="{Binding HealthKind}" Value="Unknown"><Setter Property="Foreground" Value="#9BA3AE"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0">
                <Button Style="{StaticResource PrimaryToolbarButton}" Command="{Binding StartCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE768;"/><TextBlock Text="{local:Tr Source='Iniciar'}"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding StopCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE71A;"/><TextBlock Text="{local:Tr Source='Parar'}"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding RestartCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;"/><TextBlock Text="{local:Tr Source='Reiniciar'}"/></StackPanel>
                </Button>
                <Border Width="1" Height="24" Background="#343A43" Margin="4,7,13,0"/>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding StartAllCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE768;"/><TextBlock Text="{local:Tr Source='Iniciar todos'}"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding StopAllCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE71A;"/><TextBlock Text="{local:Tr Source='Parar todos'}"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;"/><TextBlock Text="{local:Tr Source='Refrescar'}"/></StackPanel>
                </Button>
            </WrapPanel>
            <WrapPanel Grid.Column="1">
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenFolderCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8B7;"/><TextBlock Text="{local:Tr Source='Carpeta'}"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenDiagCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8A5;"/><TextBlock Text="Diag"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Click="Repositories_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8B7;"/><TextBlock Text="{local:Tr Source='Repositorios'}"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Click="Statistics_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE9D2;"/><TextBlock Text="{local:Tr Source='Estadísticas'}"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Margin="0" Click="Settings_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE713;"/><TextBlock Text="{local:Tr Source='Configuración'}"/></StackPanel>
                </Button>
            </WrapPanel>
        </Grid>

        <!-- Smart runner queue -->
        <Border Grid.Row="2" Style="{StaticResource PanelCard}" Padding="13,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Grid.RowSpan="2" VerticalAlignment="Center">
                    <TextBlock Text="{local:Tr Source='COLA INTELIGENTE'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding QueueStateText}" FontSize="16" FontWeight="Bold" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#8F97A1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding QueueStateKind}" Value="Active"><Setter Property="Foreground" Value="#67AF87"/></DataTrigger>
                                    <DataTrigger Binding="{Binding QueueStateKind}" Value="Paused"><Setter Property="Foreground" Value="#C59A4A"/></DataTrigger>
                                    <DataTrigger Binding="{Binding QueueStateKind}" Value="Blocked"><Setter Property="Foreground" Value="#C78D58"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="12,0,14,0">
                    <TextBlock Text="{local:Tr Source='EJECUTANDO'}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding QueueRunningText}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding QueueRunningText}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0,14,0">
                    <TextBlock Text="{local:Tr Source='SIGUIENTE'}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding QueueNextText}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding QueueNextText}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="12,0,14,0">
                    <TextBlock Text="{local:Tr Source='EN ESPERA'}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding QueueWaitingText}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding QueueWaitingText}"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="12,0,14,0">
                    <TextBlock Text="{local:Tr Source='PARADOS MANUALMENTE'}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding QueueManualText}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding QueueManualText}"/>
                </StackPanel>

                <Button Grid.Column="5" Grid.RowSpan="2" Style="{StaticResource ToolbarButton}" Content="{Binding QueuePauseButtonText}"
                        IsEnabled="{Binding QueueControlsEnabled}" Margin="8,0,0,0" Padding="12,6" VerticalAlignment="Center"
                        Click="QueuePause_Click"/>

                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding QueueReasonText}"
                           FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="12,6,14,0"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding QueueReasonText}"/>
            </Grid>
        </Border>

        <!-- Runner list controls -->
        <Grid Grid.Row="3" Margin="2,0,2,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{local:Tr Source='Buscar runner'}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
            <TextBox Grid.Column="1" Width="235" Height="30" VerticalAlignment="Center" VerticalContentAlignment="Center" Text="{Binding RunnerSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{local:Tr Source='Busca por nombre, destino, etiqueta o ruta'}"/>
            <Button Grid.Column="2" Style="{StaticResource ToolbarButton}" Command="{Binding ClearRunnerSearchCommand}" Content="✕" Padding="9,5" Margin="5,0,18,0" ToolTip="{local:Tr Source='Limpiar búsqueda'}"/>
            <ComboBox Grid.Column="3" Style="{StaticResource RunnerSortCombo}" Width="205" Height="38" VerticalAlignment="Center" ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedSortMode, Mode=TwoWay}" ToolTip="{local:Tr Source='Orden de runners'}"/>
            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="7,0,0,0">
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding MoveRunnerUpCommand}" Content="↑" Padding="10,5" Margin="0,0,4,0" ToolTip="{local:Tr Source='Subir runner seleccionado en el orden manual'}"/>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding MoveRunnerDownCommand}" Content="↓" Padding="10,5" Margin="0" ToolTip="{local:Tr Source='Bajar runner seleccionado en el orden manual'}"/>
            </StackPanel>
            <TextBlock Grid.Column="5" Text="{Binding RunnerViewSummary}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- Runner table -->
        <Border Grid.Row="4" Style="{StaticResource PanelCard}" ClipToBounds="True" Margin="0,0,0,14">
            <DataGrid ItemsSource="{Binding Runners}" SelectedItem="{Binding SelectedRunner, Mode=TwoWay}" AlternationCount="2" CanUserSortColumns="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{local:Tr Source='ESTADO'}" Width="112">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding State, Converter={StaticResource StateBrush}}"
                                        BorderBrush="{Binding State, Converter={StaticResource StateAccentBrush}}"
                                        BorderThickness="1" CornerRadius="13" Padding="9,4"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" MinWidth="90">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="{Binding State, Converter={StaticResource StateAccentBrush}}" Margin="0,1,7,0"/>
                                        <TextBlock Text="{Binding State, Converter={StaticResource StateLabel}}" Foreground="#F1F3F5" FontWeight="Bold" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="RUNNER" Width="128">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" Foreground="#F1F3F5" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="HOST / AGENT" Binding="{Binding AgentName}" Width="135">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="{local:Tr Source='DESTINO GITHUB'}" Width="1.15*" MinWidth="210">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="11" Background="#20252B" BorderBrush="#3B424C" BorderThickness="1" Margin="0,0,9,0">
                                        <TextBlock Text="GH" FontSize="11" FontWeight="Bold" Foreground="#D6DBE1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding GitHubTarget}" Foreground="#D6DBE1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>


                    <DataGridTemplateColumn Header="{local:Tr Source='PROGRESO'}" Width="1.15*" MinWidth="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock x:Name="IdleProgress" Text="—" Foreground="#60758D" VerticalAlignment="Center"/>
                                    <StackPanel x:Name="BusyProgress" Visibility="Collapsed" VerticalAlignment="Center" ToolTip="{Binding Progress.EstimateSourceDisplay, Converter={StaticResource LocalizedText}}">
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Progress.PhaseDisplay, Converter={StaticResource LocalizedText}}" FontSize="11" Foreground="#E7F0FA" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Progress.PercentDisplay, Converter={StaticResource LocalizedText}}" FontSize="11" FontWeight="Bold" Foreground="#C59A4A" Margin="8,0,0,0"/>
                                        </Grid>
                                        <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Progress.Percent, Mode=OneWay}"
                                                     Foreground="#C59A4A" Background="#1A2A3E" BorderThickness="0">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar">
                                                    <Setter Property="IsIndeterminate" Value="True"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Progress.HasEstimate}" Value="True">
                                                            <Setter Property="IsIndeterminate" Value="False"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                        <TextBlock Text="{Binding Progress.CompactMetaDisplay, Converter={StaticResource LocalizedText}}" FontSize="11" Foreground="#7F95AC" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static models:RunnerState.Busy}">
                                        <Setter TargetName="IdleProgress" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="BusyProgress" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{local:Tr Source='MODO'}" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Foreground="#72B7FF" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ModeDisplay, Converter={StaticResource LocalizedText}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="PID" Binding="{Binding PidDisplay}" Width="62">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="RAM" Binding="{Binding RamDisplay}" Width="72">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="UPTIME" Binding="{Binding UptimeDisplay}" Width="82">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="{local:Tr Source='VERSIÓN'}" Binding="{Binding Version}" Width="78">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Detail + log -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.88*"/><ColumnDefinition Width="1.62*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelCard}" Margin="0,0,7,0" Padding="17">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,13">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="8" Background="#28364B" Margin="0,0,9,0">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#6F91C4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{local:Tr Source='Detalle del runner'}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{Binding SelectedRunner.State, Converter={StaticResource StateBrush}}"
                                BorderBrush="{Binding SelectedRunner.State, Converter={StaticResource StateAccentBrush}}" BorderThickness="1"
                                CornerRadius="12" Padding="9,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{Binding SelectedRunner.State, Converter={StaticResource StateAccentBrush}}" Margin="0,1,7,0"/>
                                <TextBlock Text="{Binding SelectedRunner.State, Converter={StaticResource StateLabel}}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,14">
                        <TextBlock Text="{Binding SelectedRunner.Alias, TargetNullValue=Selecciona un runner}" FontSize="23" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedRunner.GitHubTarget}" Foreground="#78B9FF" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Border Grid.Row="2" x:Name="SelectedProgressCard" Background="#191C21" BorderBrush="#5A4D32" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedRunner.State}" Value="{x:Static models:RunnerState.Busy}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{local:Tr Source='Trabajo en curso'}" FontSize="11" Foreground="#A89355" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedRunner.Progress.JobDisplay, Converter={StaticResource LocalizedText}}" FontSize="11" Foreground="#8FB6DE" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding SelectedRunner.Progress.PhaseDisplay, Converter={StaticResource LocalizedText}}" FontSize="13" FontWeight="SemiBold" Foreground="#F6F8FB" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedRunner.Progress.PercentDisplay, Converter={StaticResource LocalizedText}}" Foreground="#C59A4A" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>
                            <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding SelectedRunner.Progress.Percent, Mode=OneWay}"
                                         Foreground="#C59A4A" Background="#213044" BorderThickness="0">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="IsIndeterminate" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedRunner.Progress.HasEstimate}" Value="True">
                                                <Setter Property="IsIndeterminate" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SelectedRunner.Progress.MetaDisplay, Converter={StaticResource LocalizedText}}" FontSize="11" Foreground="#AFC0D2"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedRunner.Progress.EstimateSourceDisplay, Converter={StaticResource LocalizedText}}" FontSize="11" Foreground="#8F97A1" Margin="10,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="116"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Host / agent" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedRunner.AgentName}"/>
                        <TextBlock Grid.Row="1" Text="{local:Tr Source='Modo'}" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedRunner.ModeDisplay, Converter={StaticResource LocalizedText}}"/>
                        <TextBlock Grid.Row="2" Text="PID" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedRunner.PidDisplay}"/>
                        <TextBlock Grid.Row="3" Text="RAM" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedRunner.RamDisplay}"/>
                        <TextBlock Grid.Row="4" Text="Uptime" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedRunner.UptimeDisplay}"/>
                        <TextBlock Grid.Row="5" Text="{local:Tr Source='Versión'}" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedRunner.Version}"/>
                        <TextBlock Grid.Row="6" Text="{local:Tr Source='Servicio'}" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedRunner.ServiceName}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="7" Text="{local:Tr Source='Carpeta'}" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedRunner.FolderPath}" TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenFolderCommand}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8B7;"/><TextBlock Text="{local:Tr Source='Abrir carpeta'}"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenGitHubCommand}" Margin="0">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8A7;"/><TextBlock Text="{local:Tr Source='Abrir en GitHub'}"/></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelCard}" Margin="7,0,0,0" Padding="15">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="8" Background="#28364B" Margin="0,0,9,0">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#6F91C4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{local:Tr Source='Último log'}" Style="{StaticResource SectionTitle}"/>
                                    <Border Margin="9,1,0,0" Padding="6,2" CornerRadius="7" Background="#223229" BorderBrush="#3D6F53" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="#5AA878" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="LIVE" FontSize="11" FontWeight="Bold" Foreground="#67AF87"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{local:Tr Source='Salida reciente del runner seleccionado'}" Style="{StaticResource MutedLabel}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource ToolbarButton}" Command="{Binding ClearLogCommand}" Margin="0" Padding="10,6">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE74D;"/><TextBlock Text="{local:Tr Source='Limpiar vista'}"/></StackPanel>
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" Background="#111419" BorderBrush="#303640" BorderThickness="1" CornerRadius="8" Padding="1">
                        <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Padding="12" AcceptsReturn="True"
                                 Background="Transparent" BorderThickness="0"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Host PC resources; values include all applications, not only runners. -->
        <Border Grid.Row="6" Style="{StaticResource PanelCard}" Padding="14,9" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="165"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{local:Tr Source='RECURSOS DEL EQUIPO'}" FontSize="11" FontWeight="Bold" Foreground="#D9DEE5"/>
                    <TextBlock Text="{local:Tr Source='Uso total del PC'}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,18,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="CPU" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding CpuUseText}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding CpuPercent, Mode=OneWay}" Foreground="#6F91C4" Background="#1A2A3E" BorderThickness="0" Margin="0,5,0,3"/>
                    <TextBlock Text="{Binding CpuCapacityText}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0,18,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="RAM" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding MemoryUseText}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding MemoryPercent, Mode=OneWay}" Foreground="#67AF87" Background="#1A2A3E" BorderThickness="0" Margin="0,5,0,3"/>
                    <TextBlock Text="{local:Tr Source='Memoria usada / total'}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="12,0,0,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{local:Tr Source='DISCO DEL SISTEMA'}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding DiskUseText}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding DiskPercent, Mode=OneWay}" Foreground="#C59A4A" Background="#1A2A3E" BorderThickness="0" Margin="0,5,0,3"/>
                    <TextBlock Text="{local:Tr Source='Espacio usado / total'}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="7" Margin="2,12,2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="9" Height="9" Fill="#5AA878" Margin="0,1,8,0"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="{Binding QueueStatusText}" Foreground="{StaticResource AccentBrush}" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding LastUpdatedText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="  ·  " Foreground="#3D5873" VerticalAlignment="Center"/>
                <TextBlock FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Opacity="0.78" VerticalAlignment="Center" ToolTip="{local:Tr Source='Acerca de · Neo RS'}">
                    <Hyperlink Click="About_Click" Foreground="{StaticResource MutedBrush}" TextDecorations="{x:Null}">Neo RS</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
