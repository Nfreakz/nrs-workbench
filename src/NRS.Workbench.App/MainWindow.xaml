<Window x:Class="NRS.Workbench.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:NRS.Workbench.App.Converters"
        xmlns:models="clr-namespace:NRS.Workbench.Core.Models;assembly=NRS.Workbench.Core"
        Title="NRS Workbench" Icon="/Assets/NRSWorkbench.ico" Width="1580" Height="910" MinWidth="1240" MinHeight="760"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <conv:RunnerStateBrushConverter x:Key="StateBrush"/>
        <conv:RunnerStateAccentBrushConverter x:Key="StateAccentBrush"/>
        <conv:RunnerStateLabelConverter x:Key="StateLabel"/>
    </Window.Resources>

    <Grid Background="{StaticResource BgBrush}" Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="336"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="60" Height="60" CornerRadius="16" Background="#071725" BorderBrush="#2F6FAF" BorderThickness="1" ClipToBounds="True">
                    <Image Source="/Assets/NRSWorkbench.png" Stretch="Uniform" Margin="3"/>
                </Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="NRS Workbench" FontSize="31" FontWeight="Bold"/>
                    <TextBlock Text="Runners y repositorios locales desde un solo sitio" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="1,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource StatCard}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" CornerRadius="7" Background="#173B61" VerticalAlignment="Center">
                            <TextBlock Text="&#xECA5;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#67B3FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="RUNNERS" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding TotalCount}" FontSize="21" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Fill="#3DDC84" Margin="0,1,11,0"/>
                        <StackPanel><TextBlock Text="READY" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding ReadyCount}" FontSize="21" FontWeight="Bold"/></StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Fill="#F5C451" Margin="0,1,11,0"/>
                        <StackPanel><TextBlock Text="BUSY" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding BusyCount}" FontSize="21" FontWeight="Bold"/></StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Fill="#FF6470" Margin="0,1,11,0"/>
                        <StackPanel><TextBlock Text="STOPPED" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding StoppedCount}" FontSize="21" FontWeight="Bold"/></StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Margin="0,1,11,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#3DDC84"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HealthKind}" Value="Warning"><Setter Property="Fill" Value="#F5C451"/></DataTrigger>
                                        <DataTrigger Binding="{Binding HealthKind}" Value="Alert"><Setter Property="Fill" Value="#FF6470"/></DataTrigger>
                                        <DataTrigger Binding="{Binding HealthKind}" Value="Unknown"><Setter Property="Fill" Value="#6F879F"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <StackPanel>
                            <TextBlock Text="SALUD" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding HealthLabel}" FontSize="16" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#72E6A5"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HealthKind}" Value="Warning"><Setter Property="Foreground" Value="#F5C451"/></DataTrigger>
                                            <DataTrigger Binding="{Binding HealthKind}" Value="Alert"><Setter Property="Foreground" Value="#FF7C86"/></DataTrigger>
                                            <DataTrigger Binding="{Binding HealthKind}" Value="Unknown"><Setter Property="Foreground" Value="#8EA2B7"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0">
                <Button Style="{StaticResource PrimaryToolbarButton}" Command="{Binding StartCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE768;"/><TextBlock Text="Iniciar"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding StopCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE71A;"/><TextBlock Text="Parar"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding RestartCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;"/><TextBlock Text="Reiniciar"/></StackPanel>
                </Button>
                <Border Width="1" Height="24" Background="#2A405B" Margin="4,7,13,0"/>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding StartAllCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE768;"/><TextBlock Text="Iniciar todos"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding StopAllCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE71A;"/><TextBlock Text="Parar todos"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;"/><TextBlock Text="Refrescar"/></StackPanel>
                </Button>
            </WrapPanel>
            <WrapPanel Grid.Column="1">
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenFolderCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8B7;"/><TextBlock Text="Carpeta"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenDiagCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8A5;"/><TextBlock Text="Diag"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Click="Repositories_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8B7;"/><TextBlock Text="Repositorios"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Click="Statistics_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE9D2;"/><TextBlock Text="Estadísticas"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Margin="0" Click="Settings_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE713;"/><TextBlock Text="Configuración"/></StackPanel>
                </Button>
            </WrapPanel>
        </Grid>

        <!-- Runner table -->
        <Border Grid.Row="2" Style="{StaticResource PanelCard}" ClipToBounds="True" Margin="0,0,0,14">
            <DataGrid ItemsSource="{Binding Runners}" SelectedItem="{Binding SelectedRunner, Mode=TwoWay}" AlternationCount="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="ESTADO" Width="112">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding State, Converter={StaticResource StateBrush}}"
                                        BorderBrush="{Binding State, Converter={StaticResource StateAccentBrush}}"
                                        BorderThickness="1" CornerRadius="13" Padding="9,4"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" MinWidth="90">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="{Binding State, Converter={StaticResource StateAccentBrush}}" Margin="0,1,7,0"/>
                                        <TextBlock Text="{Binding State, Converter={StaticResource StateLabel}}" Foreground="#F7FBFF" FontWeight="Bold" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="RUNNER" Width="128">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" Foreground="#F7FAFE" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="HOST / AGENT" Binding="{Binding AgentName}" Width="135"/>

                    <DataGridTemplateColumn Header="DESTINO GITHUB" Width="1.15*" MinWidth="210">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="11" Background="#18283B" BorderBrush="#304865" BorderThickness="1" Margin="0,0,9,0">
                                        <TextBlock Text="GH" FontSize="7" FontWeight="Bold" Foreground="#DCE8F5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding GitHubTarget}" Foreground="#D9E6F4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>


                    <DataGridTemplateColumn Header="PROGRESO" Width="1.15*" MinWidth="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock x:Name="IdleProgress" Text="—" Foreground="#60758D" VerticalAlignment="Center"/>
                                    <StackPanel x:Name="BusyProgress" Visibility="Collapsed" VerticalAlignment="Center" ToolTip="{Binding Progress.EstimateSourceDisplay}">
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Progress.PhaseDisplay}" FontSize="11" Foreground="#E7F0FA" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Progress.PercentDisplay}" FontSize="10" FontWeight="Bold" Foreground="#F5C451" Margin="8,0,0,0"/>
                                        </Grid>
                                        <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Progress.Percent, Mode=OneWay}"
                                                     Foreground="#F5C451" Background="#1A2A3E" BorderThickness="0">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar">
                                                    <Setter Property="IsIndeterminate" Value="True"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Progress.HasEstimate}" Value="True">
                                                            <Setter Property="IsIndeterminate" Value="False"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                        <TextBlock Text="{Binding Progress.CompactMetaDisplay}" FontSize="9" Foreground="#7F95AC" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static models:RunnerState.Busy}">
                                        <Setter TargetName="IdleProgress" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="BusyProgress" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="MODO" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Foreground="#72B7FF" FontSize="13" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding ModeDisplay}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="PID" Binding="{Binding PidDisplay}" Width="62"/>
                    <DataGridTextColumn Header="RAM" Binding="{Binding RamDisplay}" Width="72"/>
                    <DataGridTextColumn Header="UPTIME" Binding="{Binding UptimeDisplay}" Width="82"/>
                    <DataGridTextColumn Header="VERSIÓN" Binding="{Binding Version}" Width="78"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Detail + log -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.88*"/><ColumnDefinition Width="1.62*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelCard}" Margin="0,0,7,0" Padding="17">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,13">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="8" Background="#173A61" Margin="0,0,9,0">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#71B7FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Detalle del runner" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{Binding SelectedRunner.State, Converter={StaticResource StateBrush}}"
                                BorderBrush="{Binding SelectedRunner.State, Converter={StaticResource StateAccentBrush}}" BorderThickness="1"
                                CornerRadius="12" Padding="9,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{Binding SelectedRunner.State, Converter={StaticResource StateAccentBrush}}" Margin="0,1,7,0"/>
                                <TextBlock Text="{Binding SelectedRunner.State, Converter={StaticResource StateLabel}}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,14">
                        <TextBlock Text="{Binding SelectedRunner.Alias, TargetNullValue=Selecciona un runner}" FontSize="23" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedRunner.GitHubTarget}" Foreground="#78B9FF" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Border Grid.Row="2" x:Name="SelectedProgressCard" Background="#111E2E" BorderBrush="#5B4A1C" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedRunner.State}" Value="{x:Static models:RunnerState.Busy}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Trabajo en curso" FontSize="10" Foreground="#A89355" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedRunner.Progress.JobDisplay}" FontSize="11" Foreground="#8FB6DE" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding SelectedRunner.Progress.PhaseDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="#F6F8FB" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedRunner.Progress.PercentDisplay}" Foreground="#F5C451" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>
                            <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding SelectedRunner.Progress.Percent, Mode=OneWay}"
                                         Foreground="#F5C451" Background="#213044" BorderThickness="0">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="IsIndeterminate" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedRunner.Progress.HasEstimate}" Value="True">
                                                <Setter Property="IsIndeterminate" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SelectedRunner.Progress.MetaDisplay}" FontSize="10.5" Foreground="#AFC0D2"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedRunner.Progress.EstimateSourceDisplay}" FontSize="9.5" Foreground="#6F879F" Margin="10,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="116"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Host / agent" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedRunner.AgentName}"/>
                        <TextBlock Grid.Row="1" Text="Modo" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedRunner.ModeDisplay}"/>
                        <TextBlock Grid.Row="2" Text="PID" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedRunner.PidDisplay}"/>
                        <TextBlock Grid.Row="3" Text="RAM" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedRunner.RamDisplay}"/>
                        <TextBlock Grid.Row="4" Text="Uptime" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedRunner.UptimeDisplay}"/>
                        <TextBlock Grid.Row="5" Text="Versión" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedRunner.Version}"/>
                        <TextBlock Grid.Row="6" Text="Servicio" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedRunner.ServiceName}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="7" Text="Carpeta" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedRunner.FolderPath}" TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenFolderCommand}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8B7;"/><TextBlock Text="Abrir carpeta"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenGitHubCommand}" Margin="0">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8A7;"/><TextBlock Text="Abrir en GitHub"/></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelCard}" Margin="7,0,0,0" Padding="15">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="8" Background="#173A61" Margin="0,0,9,0">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#71B7FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Último log" Style="{StaticResource SectionTitle}"/>
                                    <Border Margin="9,1,0,0" Padding="6,2" CornerRadius="7" Background="#103524" BorderBrush="#217A4B" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="#3DDC84" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="LIVE" FontSize="9" FontWeight="Bold" Foreground="#72E6A5"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Salida reciente del runner seleccionado" Style="{StaticResource MutedLabel}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource ToolbarButton}" Command="{Binding ClearLogCommand}" Margin="0" Padding="10,6">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE74D;"/><TextBlock Text="Limpiar vista"/></StackPanel>
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" Background="#07111D" BorderBrush="#263F5C" BorderThickness="1" CornerRadius="8" Padding="1">
                        <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Padding="12" AcceptsReturn="True"
                                 Background="Transparent" BorderThickness="0"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="2,12,2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="9" Height="9" Fill="#3DDC84" Margin="0,1,8,0"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding LastUpdatedText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="  ·  " Foreground="#3D5873" VerticalAlignment="Center"/>
                <TextBlock FontFamily="Segoe Script" FontSize="13" FontWeight="SemiBold" Opacity="0.78" VerticalAlignment="Center" ToolTip="Acerca de · Neo RS">
                    <Hyperlink Click="About_Click" Foreground="#5EA7E8" TextDecorations="{x:Null}">Neo RS</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
