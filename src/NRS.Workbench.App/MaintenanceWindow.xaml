<Window x:Class="NRS.Workbench.App.MaintenanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NRS.Workbench.App.Services"
        Title="{local:Tr Source='Mantenimiento · NRS Workbench'}" Icon="/Assets/NRSWorkbench.ico"
        Width="1080" Height="720" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{local:Tr Source='Centro de mantenimiento'}" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="{local:Tr Source='Mide primero. Limpia solo elementos clasificados y revisables.'}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{local:Tr Source='Logs anteriores a'}" Style="{StaticResource MutedLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="DaysChoice" Width="90" SelectedValuePath="Tag" SelectionChanged="DaysChoice_SelectionChanged">
                    <ComboBoxItem Content="7" Tag="7"/><ComboBoxItem Content="30" Tag="30" IsSelected="True"/><ComboBoxItem Content="90" Tag="90"/><ComboBoxItem Content="180" Tag="180"/>
                </ComboBox>
                <Button Content="{local:Tr Source='Escanear'}" Style="{StaticResource ToolbarButton}" Margin="10,0,0,0" Padding="12,7" Click="Refresh_Click"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelCard}" Padding="14"><StackPanel><TextBlock Text="{local:Tr Source='ESTADO'}" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="StatusText" Text="{local:Tr Source='Sin escanear'}" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource PanelCard}" Padding="14" Margin="12,0,0,0"><StackPanel><TextBlock Text="{local:Tr Source='ESPACIO MEDIDO'}" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="MeasuredText" Text="—" FontSize="19" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="14" Margin="12,0,0,0"><StackPanel><TextBlock Text="{local:Tr Source='RECUPERABLE'}" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ReclaimableText" Text="—" FontSize="19" FontWeight="Bold" Foreground="#67AF87" Margin="0,3,0,0"/></StackPanel></Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource PanelCard}" Padding="8">
            <DataGrid x:Name="MaintenanceGrid" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="46"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsCleanable}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="{local:Tr Source='CATEGORÍA'}" Binding="{Binding Category}" Width="190" IsReadOnly="True"/>
                    <DataGridTextColumn Header="{local:Tr Source='RIESGO'}" Binding="{Binding RiskLabel}" Width="130" IsReadOnly="True"/>
                    <DataGridTextColumn Header="{local:Tr Source='ARCHIVOS'}" Binding="{Binding FileCount}" Width="82" IsReadOnly="True"/>
                    <DataGridTextColumn Header="{local:Tr Source='TAMAÑO'}" Binding="{Binding TotalDisplay}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="{local:Tr Source='RECUPERABLE'}" Binding="{Binding ReclaimableDisplay}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="{local:Tr Source='DETALLE'}" Binding="{Binding Detail}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{local:Tr Source='_work se inventaría pero nunca se borra automáticamente. Los logs _diag antiguos pueden afectar estadísticas y estimaciones.'}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{local:Tr Source='Abrir ubicación'}" Style="{StaticResource ToolbarButton}" Padding="12,7" Click="OpenLocation_Click"/>
                <Button x:Name="CleanButton" Content="{local:Tr Source='Limpiar selección'}" Style="{StaticResource PrimaryToolbarButton}" Padding="14,7" Margin="8,0,0,0" Click="Clean_Click"/>
                <Button Content="{local:Tr Source='Cerrar'}" Style="{StaticResource ToolbarButton}" Padding="12,7" Margin="8,0,0,0" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
