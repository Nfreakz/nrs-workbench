<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>NRSWorkbench</AssemblyName>
    <RootNamespace>NRS.Workbench.App</RootNamespace>
    <ApplicationIcon>Assets\NRSWorkbench.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFAC010: WinForms (used only for the tray icon) wants DPI mode set in code, but WPF
         only honours Per-Monitor V2 through the manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\NRSWorkbench.ico" />
    <Resource Include="Assets\NRSWorkbench.png" />
    <Resource Include="Assets\NRSWorkbenchFull.png" />
    <Resource Include="Localization\en.json" />
    <Resource Include="Localization\ca.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NRS.Workbench.Core\NRS.Workbench.Core.csproj" />
  </ItemGroup>
</Project>
