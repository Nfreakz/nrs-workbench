<Window x:Class="NRS.Workbench.App.PortableWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NRS.Workbench.App.Services"
        Title="{local:Tr Source='Espacio portable · NRS Workbench'}"
        Icon="/Assets/NRSWorkbench.ico"
        Width="1080" Height="720" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{local:Tr Source='Espacio portable'}" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="{local:Tr Source='Lleva configuración y runners interactivos en una unidad externa sin depender de la letra del disco.'}"
                           Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#1B2026" BorderBrush="#3A424D" BorderThickness="1" CornerRadius="8" Padding="12,7" VerticalAlignment="Center">
                <TextBlock x:Name="ModeBadge" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Border x:Name="ActivationPanel" Grid.Row="1" Grid.RowSpan="2" Style="{StaticResource PanelCard}" Padding="20">
            <StackPanel VerticalAlignment="Center" MaxWidth="720">
                <TextBlock Text="{local:Tr Source='Activar modo portable en esta copia'}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="{local:Tr Source='NRS Workbench creará un marcador junto al ejecutable y guardará sus datos en la carpeta Data. Las rutas de esta unidad se almacenarán de forma relativa para sobrevivir a cambios de letra.'}"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <Border Background="#15181C" BorderBrush="#303640" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="{local:Tr Source='No copia ni exporta credenciales de los runners.'}" FontWeight="SemiBold"/>
                        <TextBlock Text="{local:Tr Source='Después de activar el modo portable hay que reiniciar NRS Workbench. Los runners interactivos existentes de esta unidad quedarán registrados como preparados para el PC actual.'}"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Button Content="{local:Tr Source='Activar modo portable'}" Style="{StaticResource PrimaryToolbarButton}"
                        Padding="16,9" HorizontalAlignment="Left" Margin="0,18,0,0" Click="Activate_Click"/>
            </StackPanel>
        </Border>

        <Grid x:Name="PortablePanel" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PortablePathText" FontWeight="SemiBold"/>
                    <TextBlock Text="{local:Tr Source='El token de acceso de GitHub se usa solo durante esta operación y no se guarda en settings, Data ni el manifiesto portable.'}"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{local:Tr Source='Actualizar runners'}" Style="{StaticResource ToolbarButton}"
                        Padding="12,7" Margin="12,0,0,0" VerticalAlignment="Center" Click="Refresh_Click"/>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource PanelCard}" Padding="8">
                <DataGrid x:Name="RunnerGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="False" SelectionMode="Single" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="46">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanPrepare}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{local:Tr Source='RUNNER'}" Binding="{Binding DisplayName}" Width="180" IsReadOnly="True"/>
                        <DataGridTextColumn Header="{local:Tr Source='GITHUB'}" Binding="{Binding GitHubUrl}" Width="270" IsReadOnly="True"/>
                        <DataGridTextColumn Header="{local:Tr Source='ESTADO'}" Binding="{Binding StateLabel}" Width="210" IsReadOnly="True"/>
                        <DataGridTextColumn Header="{local:Tr Source='RESULTADO'}" Binding="{Binding ResultText}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{local:Tr Source='Token de acceso de GitHub para esta sesión'}" Style="{StaticResource MutedLabel}"/>
                    <PasswordBox x:Name="TokenBox" Width="420" HorizontalAlignment="Left" Padding="10,7" Margin="0,6,0,0"/>
                    <TextBlock Text="{local:Tr Source='Para repositorios necesita Administration: write; para organizaciones, Self-hosted runners: write.'}"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="PrepareButton" Content="{local:Tr Source='Preparar seleccionados'}"
                            Style="{StaticResource PrimaryToolbarButton}" Padding="14,8" Click="Prepare_Click"/>
                    <Button Content="{local:Tr Source='Cerrar'}" Style="{StaticResource ToolbarButton}"
                            Padding="12,8" Margin="8,0,0,0" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="InactiveCloseButton" Content="{local:Tr Source='Cerrar'}" Style="{StaticResource ToolbarButton}"
                    Padding="12,8" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
