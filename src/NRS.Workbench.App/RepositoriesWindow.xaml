<Window x:Class="NRS.Workbench.App.RepositoriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Repositorios · NRS Workbench" Icon="/Assets/NRSWorkbench.ico"
        Width="1480" Height="860" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Background="{StaticResource BgBrush}" Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="245"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,17">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="58" Height="58" CornerRadius="15" Background="#143A63" BorderBrush="#2F6FAF" BorderThickness="1">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#7DBBFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Repositorios" FontSize="29" FontWeight="Bold"/>
                    <TextBlock Text="Estado Git, sincronización segura y acceso rápido a tus proyectos locales" FontSize="13.5" Foreground="{StaticResource MutedBrush}" Margin="1,3,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="REPOS" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding TotalCount}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
                <Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="CLEAN" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding CleanCount}" Foreground="#3DDC84" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
                <Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="CAMBIOS" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding ChangesCount}" Foreground="#F5C451" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
                <Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="AHEAD" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding AheadCount}" Foreground="#67B3FF" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
                <Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="ATENCIÓN" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding AttentionCount}" Foreground="#FF6470" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,13">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0">
                <Button Style="{StaticResource PrimaryToolbarButton}" Click="AddRepository_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE710;"/><TextBlock Text="Añadir repositorio"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Click="ScanFolder_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8B7;"/><TextBlock Text="Escanear carpeta"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding RemoveCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE74D;"/><TextBlock Text="Quitar"/></StackPanel>
                </Button>
                <Border Width="1" Height="24" Background="#2A405B" Margin="4,7,13,0"/>
                <Button Style="{StaticResource PrimaryToolbarButton}" Click="Commit_Click" IsEnabled="{Binding SelectedRepository.CanCommit}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE73E;"/><TextBlock Text="Commit..."/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding FetchCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;"/><TextBlock Text="Fetch"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding PullCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE896;"/><TextBlock Text="Pull"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding PushCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE898;"/><TextBlock Text="Push"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;"/><TextBlock Text="Refrescar"/></StackPanel>
                </Button>
            </WrapPanel>
            <TextBlock Grid.Column="1" Text="{Binding GitVersionText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PanelCard}" Margin="0,0,0,13">
            <DataGrid ItemsSource="{Binding Repositories}" SelectedItem="{Binding SelectedRepository, Mode=TwoWay}" AlternationCount="2" HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="ESTADO" Width="112">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="9,4" CornerRadius="10" BorderThickness="1" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#13283C"/><Setter Property="BorderBrush" Value="#35536D"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Clean"><Setter Property="Background" Value="#0D3B28"/><Setter Property="BorderBrush" Value="#1E9A59"/></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Changes"><Setter Property="Background" Value="#4A3810"/><Setter Property="BorderBrush" Value="#A47B18"/></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Ahead"><Setter Property="Background" Value="#123B62"/><Setter Property="BorderBrush" Value="#367FBE"/></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Behind"><Setter Property="Background" Value="#26365A"/><Setter Property="BorderBrush" Value="#5B78B5"/></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Diverged"><Setter Property="Background" Value="#4A2810"/><Setter Property="BorderBrush" Value="#D07A20"/></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Conflict"><Setter Property="Background" Value="#511922"/><Setter Property="BorderBrush" Value="#D34D5C"/></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Error"><Setter Property="Background" Value="#511922"/><Setter Property="BorderBrush" Value="#D34D5C"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StateLabel}" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="REPOSITORIO" Binding="{Binding Name}" Width="180"/>
                    <DataGridTextColumn Header="BRANCH" Binding="{Binding Branch}" Width="135"/>
                    <DataGridTextColumn Header="CAMBIOS" Binding="{Binding ChangeSummary}" Width="110"/>
                    <DataGridTextColumn Header="AHEAD" Binding="{Binding AheadDisplay}" Width="70"/>
                    <DataGridTextColumn Header="BEHIND" Binding="{Binding BehindDisplay}" Width="72"/>
                    <DataGridTextColumn Header="ÚLTIMO COMMIT" Binding="{Binding LastCommitDisplay}" Width="2*"/>
                    <DataGridTextColumn Header="FECHA" Binding="{Binding LastCommitWhenDisplay}" Width="130"/>
                    <DataGridTextColumn Header="ORIGIN" Binding="{Binding RemoteUrl}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="17" Margin="0,0,7,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedRepository.Name, TargetNullValue='Selecciona un repositorio'}" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedRepository.Path}" Foreground="#6FADE8" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedRepository.StateLabel}" Foreground="#F5C451" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Grid>
                    <Separator Grid.Row="1" Margin="0,13" Background="#263D5A"/>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Branch" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedRepository.Branch}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Upstream" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding SelectedRepository.Upstream}"/>
                        <TextBlock Grid.Row="1" Text="Modificados" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedRepository.ModifiedCount}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Nuevos" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding SelectedRepository.UntrackedCount}"/>
                        <TextBlock Grid.Row="2" Text="Añadidos" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedRepository.AddedCount}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Eliminados" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding SelectedRepository.DeletedCount}"/>
                        <TextBlock Grid.Row="3" Text="Ahead" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedRepository.Ahead}"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Behind" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding SelectedRepository.Behind}"/>
                        <TextBlock Grid.Row="4" Text="Último commit" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SelectedRepository.LastCommitDisplay}" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,13,0,0">
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenFolderCommand}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8B7;"/><TextBlock Text="Carpeta"/></StackPanel></Button>
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenTerminalCommand}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE756;"/><TextBlock Text="Terminal"/></StackPanel></Button>
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenGitHubCommand}" Margin="0"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8A7;"/><TextBlock Text="GitHub"/></StackPanel></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelCard}" Padding="17" Margin="7,0,0,0">
                <StackPanel>
                    <TextBlock Text="Sincronización segura" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="La aplicación usa el Git instalado en Windows. No implementa Git ni hace merges automáticos." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,14"/>
                    <Border Background="#0B1B2C" BorderBrush="#29425F" BorderThickness="1" CornerRadius="9" Padding="12">
                        <StackPanel>
                            <TextBlock Text="COMMIT" Foreground="#7DBBFF" FontWeight="Bold"/>
                            <TextBlock Text="Selecciona archivos, revisa el diff y confirma el mensaje antes de modificar el índice de Git." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,10"/>
                            <TextBlock Text="FETCH" Foreground="#67B3FF" FontWeight="Bold"/>
                            <TextBlock Text="Seguro: actualiza referencias remotas sin modificar tu working tree." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,10"/>
                            <TextBlock Text="PULL" Foreground="#72E6A5" FontWeight="Bold"/>
                            <TextBlock Text="Solo se permite como fast-forward y con working tree limpio. Si hay divergencia, se bloquea." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,10"/>
                            <TextBlock Text="PUSH" Foreground="#F5C451" FontWeight="Bold"/>
                            <TextBlock Text="Se confirma antes de enviar commits. Si el remoto va por delante, se bloquea." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="2,11,2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="9" Height="9" Fill="#3DDC84" Margin="0,1,8,0"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="{Binding LastUpdatedText}" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="  ·  Neo RS" FontFamily="Segoe Script" FontSize="12" Foreground="#5EA7E8" Opacity="0.76"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
