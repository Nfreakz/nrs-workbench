<Window x:Class="NRS.Workbench.App.RepositoriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NRS.Workbench.App.Services"
        Title="{local:Tr Source='Repositorios · NRS Workbench'}" Icon="/Assets/NRSWorkbench.ico"
        Width="1480" Height="860" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Background="{StaticResource BgBrush}" Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="292"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,17">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="58" Height="58" CornerRadius="15" Background="#143A63" BorderBrush="#2F6FAF" BorderThickness="1">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#7DBBFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{local:Tr Source='Repositorios'}" FontSize="29" FontWeight="Bold"/>
                    <TextBlock Text="{local:Tr Source='Estado Git, sincronización segura y acceso rápido a tus proyectos locales'}" FontSize="13.5" Foreground="{StaticResource MutedBrush}" Margin="1,3,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="REPOS" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding TotalCount}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
                <Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="CLEAN" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding CleanCount}" Foreground="#3DDC84" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
                <Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="{local:Tr Source='CAMBIOS'}" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding ChangesCount}" Foreground="#F5C451" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
                <Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="AHEAD" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding AheadCount}" Foreground="#67B3FF" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
                <Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="BEHIND" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding BehindCount}" Foreground="#8DA7FF" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
                <Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="{local:Tr Source='ATENCIÓN'}" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding AttentionCount}" Foreground="#FF6470" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,13">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0">
                <Button Style="{StaticResource PrimaryToolbarButton}" Click="AddRepository_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE710;"/><TextBlock Text="{local:Tr Source='Añadir repositorio'}"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Click="ScanFolder_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8B7;"/><TextBlock Text="{local:Tr Source='Escanear carpeta'}"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding RemoveCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE74D;"/><TextBlock Text="{local:Tr Source='Quitar'}"/></StackPanel>
                </Button>
                <Border Width="1" Height="24" Background="#2A405B" Margin="4,7,13,0"/>
                <Button Style="{StaticResource PrimaryToolbarButton}" Click="Commit_Click" IsEnabled="{Binding SelectedRepository.CanCommit}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE73E;"/><TextBlock Text="Commit..."/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Click="SwitchBranch_Click" IsEnabled="{Binding SelectedRepository.CanSwitchBranch}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8AB;"/><TextBlock Text="{local:Tr Source='Cambiar rama...'}"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding FetchCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;"/><TextBlock Text="Fetch"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding PullCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE896;"/><TextBlock Text="Pull"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding PushCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE898;"/><TextBlock Text="Push"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;"/><TextBlock Text="{local:Tr Source='Refrescar'}"/></StackPanel>
                </Button>
            </WrapPanel>
            <TextBlock Grid.Column="1" Text="{Binding GitVersionText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PanelCard}" Margin="0,0,0,13">
            <DataGrid ItemsSource="{Binding Repositories}" SelectedItem="{Binding SelectedRepository, Mode=TwoWay}" AlternationCount="2" HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{local:Tr Source='ESTADO'}" Width="112">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="9,4" CornerRadius="10" BorderThickness="1" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#13283C"/><Setter Property="BorderBrush" Value="#35536D"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Clean"><Setter Property="Background" Value="#0D3B28"/><Setter Property="BorderBrush" Value="#1E9A59"/></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Changes"><Setter Property="Background" Value="#4A3810"/><Setter Property="BorderBrush" Value="#A47B18"/></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Ahead"><Setter Property="Background" Value="#123B62"/><Setter Property="BorderBrush" Value="#367FBE"/></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Behind"><Setter Property="Background" Value="#26365A"/><Setter Property="BorderBrush" Value="#5B78B5"/></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Diverged"><Setter Property="Background" Value="#4A2810"/><Setter Property="BorderBrush" Value="#D07A20"/></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Conflict"><Setter Property="Background" Value="#511922"/><Setter Property="BorderBrush" Value="#D34D5C"/></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Error"><Setter Property="Background" Value="#511922"/><Setter Property="BorderBrush" Value="#D34D5C"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StateLabel, Converter={StaticResource LocalizedText}}" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{local:Tr Source='REPOSITORIO'}" Binding="{Binding Name}" Width="180"/>
                    <DataGridTextColumn Header="BRANCH" Binding="{Binding Branch}" Width="135"/>
                    <DataGridTextColumn Header="{local:Tr Source='CAMBIOS'}" Binding="{Binding ChangeSummary, Converter={StaticResource LocalizedText}}" Width="110"/>
                    <DataGridTextColumn Header="AHEAD" Binding="{Binding AheadDisplay}" Width="70"/>
                    <DataGridTextColumn Header="BEHIND" Binding="{Binding BehindDisplay}" Width="72"/>
                    <DataGridTextColumn Header="{local:Tr Source='ÚLTIMO COMMIT'}" Binding="{Binding LastCommitDisplay}" Width="2*"/>
                    <DataGridTextColumn Header="{local:Tr Source='FECHA'}" Binding="{Binding LastCommitWhenDisplay}" Width="130"/>
                    <DataGridTextColumn Header="ORIGIN" Binding="{Binding RemoteUrl}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="17" Margin="0,0,7,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedRepository.Name, TargetNullValue='Selecciona un repositorio'}" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedRepository.Path}" Foreground="#6FADE8" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedRepository.StateLabel, Converter={StaticResource LocalizedText}}" Foreground="#F5C451" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Grid>
                    <Separator Grid.Row="1" Margin="0,13" Background="#263D5A"/>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Branch" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedRepository.Branch}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Upstream" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding SelectedRepository.Upstream}"/>
                        <TextBlock Grid.Row="1" Text="{local:Tr Source='Modificados'}" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedRepository.ModifiedCount}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{local:Tr Source='Nuevos'}" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding SelectedRepository.UntrackedCount}"/>
                        <TextBlock Grid.Row="2" Text="{local:Tr Source='Añadidos'}" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedRepository.AddedCount}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{local:Tr Source='Eliminados'}" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding SelectedRepository.DeletedCount}"/>
                        <TextBlock Grid.Row="3" Text="Ahead" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedRepository.Ahead}"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Behind" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding SelectedRepository.Behind}"/>
                        <TextBlock Grid.Row="4" Text="{local:Tr Source='Último commit'}" Style="{StaticResource MutedLabel}"/><TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SelectedRepository.LastCommitDisplay}" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,13,0,0">
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenFolderCommand}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8B7;"/><TextBlock Text="{local:Tr Source='Carpeta'}"/></StackPanel></Button>
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenTerminalCommand}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE756;"/><TextBlock Text="Terminal"/></StackPanel></Button>
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenGitHubCommand}" Margin="0"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8A7;"/><TextBlock Text="GitHub"/></StackPanel></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelCard}" Padding="17" Margin="7,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{local:Tr Source='ACCIÓN SEGURA'}" Style="{StaticResource SectionTitle}"/>

                    <Border Grid.Row="1" Background="#0B1B2C" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,9,0,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#35536D"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSyncKind}" Value="Safe"><Setter Property="BorderBrush" Value="#1E9A59"/></DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedSyncKind}" Value="Warning"><Setter Property="BorderBrush" Value="#A47B18"/></DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedSyncKind}" Value="Blocked"><Setter Property="BorderBrush" Value="#D34D5C"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedSyncTitle}" FontSize="14" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#8DB7DF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSyncKind}" Value="Safe"><Setter Property="Foreground" Value="#72E6A5"/></DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedSyncKind}" Value="Warning"><Setter Property="Foreground" Value="#F5C451"/></DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedSyncKind}" Value="Blocked"><Setter Property="Foreground" Value="#FF7B86"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding SelectedSyncAdvice}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{local:Tr Source='ACTIVIDAD DE ESTA SESIÓN'}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="{local:Tr Source='Solo actividad iniciada desde NRS Workbench'}" FontSize="9" Foreground="#667F99"/>
                    </Grid>

                    <ListBox Grid.Row="3" ItemsSource="{Binding ActionHistory}" Background="Transparent" BorderThickness="0" Padding="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="58"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="#667F99" FontFamily="Consolas" FontSize="10"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Action}" Foreground="#7DBBFF" FontWeight="SemiBold" FontSize="10"/>
                                    <TextBlock Grid.Column="2" Text="{Binding RepositoryName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" FontSize="10"/>
                                    <TextBlock Grid.Column="3" Text="{Binding ResultText}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="10">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#72E6A5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Success}" Value="False"><Setter Property="Foreground" Value="#FF7B86"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="2,11,2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="9" Height="9" Fill="#3DDC84" Margin="0,1,8,0"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="{Binding LastUpdatedText}" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="  ·  Neo RS" FontFamily="Segoe Script" FontSize="12" Foreground="#5EA7E8" Opacity="0.76"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
