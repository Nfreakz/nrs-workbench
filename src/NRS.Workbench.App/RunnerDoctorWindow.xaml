<Window x:Class="NRS.Workbench.App.RunnerDoctorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NRS.Workbench.App.Services"
        Title="{local:Tr Source='Runner Doctor · NRS Workbench'}" Icon="/Assets/NRSWorkbench.ico"
        Width="1180" Height="760" MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{local:Tr Source='Runner Doctor'}" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="{local:Tr Source='Diagnóstico local y explicable de cada runner. No consulta credenciales ni modifica la instalación.'}"
                           Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="{local:Tr Source='Actualizar diagnóstico'}"
                    Style="{StaticResource PrimaryToolbarButton}" Padding="12,7" Margin="14,0,0,0"
                    Click="Refresh_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource StatCard}" Padding="14,10" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="OK" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="HealthyCountText" Text="0" FontSize="21" FontWeight="Bold" Foreground="#67AF87"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource StatCard}" Padding="14,10" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="{local:Tr Source='ATENCIÓN'}" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="AttentionCountText" Text="0" FontSize="21" FontWeight="Bold" Foreground="#C59A4A"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource StatCard}" Padding="14,10" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="{local:Tr Source='PROBLEMA'}" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="ProblemCountText" Text="0" FontSize="21" FontWeight="Bold" Foreground="#D56B75"/></StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource StatCard}" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="{local:Tr Source='ALCANCE'}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <TextBlock x:Name="ScopeText" Text="{local:Tr Source='Sin analizar'}" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    <TextBlock Text="{local:Tr Source='Solo señales locales verificables. STOPPED puede ser un estado completamente válido.'}"
                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="0">
                <DataGrid x:Name="RunnerGrid" ItemsSource="{Binding}" AutoGenerateColumns="False"
                          IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                          HeadersVisibility="Column" GridLinesVisibility="None"
                          Background="#15181C" BorderThickness="0"
                          RowBackground="#15181C" AlternatingRowBackground="#171B20"
                          Foreground="{StaticResource TextBrush}"
                          SelectionChanged="RunnerGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{local:Tr Source='SALUD'}" Width="92">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding HealthLabel}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#67AF87"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Attention"><Setter Property="Foreground" Value="#C59A4A"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Problem"><Setter Property="Foreground" Value="#D56B75"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="RUNNER" Binding="{Binding Runner.Alias}" Width="1.25*"/>
                        <DataGridTextColumn Header="{local:Tr Source='ESTADO'}" Binding="{Binding StateLabel}" Width="92"/>
                        <DataGridTextColumn Header="{local:Tr Source='MODO'}" Binding="{Binding ModeLabel}" Width="95"/>
                        <DataGridTextColumn Header="{local:Tr Source='VERSIÓN'}" Binding="{Binding VersionLabel}" Width="105"/>
                        <DataGridTextColumn Header="{local:Tr Source='ACTIVIDAD'}" Binding="{Binding LastActivityLabel}" Width="105"/>
                        <DataGridTextColumn Header="{local:Tr Source='RESUMEN'}" Binding="{Binding SummaryLabel}" Width="1.6*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="SelectedAliasText" Text="{local:Tr Source='Selecciona un runner'}" FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="SelectedMetaText" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Separator Grid.Row="1" Margin="0,13" Background="#303640"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ChecksList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#303640" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Ellipse Width="9" Height="9" VerticalAlignment="Top" Margin="0,5,0,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#5AA878"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Attention"><Setter Property="Fill" Value="#C59A4A"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Problem"><Setter Property="Fill" Value="#D2636D"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <StackPanel Grid.Column="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SeverityLabel}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{local:Tr Source='Runner Doctor no inicia, detiene ni reconfigura runners. Las acciones de esta ventana son de consulta.'}"
                       Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{local:Tr Source='Abrir carpeta'}" Style="{StaticResource ToolbarButton}" Click="OpenFolder_Click"/>
                <Button Content="{local:Tr Source='Abrir _diag'}" Style="{StaticResource ToolbarButton}" Click="OpenDiag_Click"/>
                <Button Content="{local:Tr Source='Copiar resumen'}" Style="{StaticResource ToolbarButton}" Click="CopySummary_Click"/>
                <Button Content="{local:Tr Source='Cerrar'}" Style="{StaticResource PrimaryToolbarButton}" Margin="0" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
