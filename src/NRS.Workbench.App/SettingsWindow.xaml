<Window x:Class="NRS.Workbench.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NRS.Workbench.App.Services"
        Title="{local:Tr Source='Configuración'}" Icon="/Assets/NRSWorkbench.ico" Width="700" Height="760" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Background="{StaticResource BgBrush}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="{local:Tr Source='Configuración'}" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="{local:Tr Source='Configura runners, notificaciones y comportamiento del NRS Workbench.'}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Style="{StaticResource PanelCard}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{local:Tr Source='Ubicaciones de runners'}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{local:Tr Source='Una raíz por línea. El escaneo dentro de cada raíz es superficial.'}" Style="{StaticResource MutedLabel}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{local:Tr Source='Detectar automáticamente'}" Style="{StaticResource ToolbarButton}" Margin="0" Padding="10,6" Click="Detect_Click"/>
                </Grid>

                <TextBox x:Name="RootsText" Grid.Row="1" Height="108" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         Padding="10" Margin="0,0,0,18"/>

                <Grid Grid.Row="2" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="175"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                        <TextBlock Text="{local:Tr Source='Patrón de carpetas'}" Style="{StaticResource MutedLabel}"/>
                        <TextBox x:Name="PatternText" Padding="9" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{local:Tr Source='Refresco (segundos)'}" Style="{StaticResource MutedLabel}"/>
                        <TextBox x:Name="RefreshText" Padding="9" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="3" Background="#15181C" BorderBrush="#303640" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <CheckBox x:Name="ConfirmBusyCheck" Content="{local:Tr Source='Confirmar antes de parar un runner BUSY'}" Foreground="{StaticResource TextBrush}"/>
                        <CheckBox x:Name="KeepInTrayCheck" Content="{local:Tr Source='Mantener NRS Workbench en la bandeja al cerrar o minimizar'}" Foreground="{StaticResource TextBrush}" Margin="0,10,0,0"/>
                        <Border BorderBrush="#303640" BorderThickness="0,1,0,0" Margin="0,12,0,10"/>
                        <CheckBox x:Name="RunnerQueueEnabledCheck" Content="{local:Tr Source='Activar cola automática de runners'}" Foreground="{StaticResource TextBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="22,8,0,0">
                            <TextBlock Text="{local:Tr Source='Máximo de runners conectados'}" Style="{StaticResource MutedLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox x:Name="RunnerQueueLimitChoice" Width="82" SelectedValuePath="Tag">
                                <ComboBoxItem Content="1" Tag="1"/>
                                <ComboBoxItem Content="2" Tag="2"/>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Text="{local:Tr Source='La app mantiene como máximo ese número de runners conectados y rota los libres cada 45 s. Los runners que ya estaban detenidos manualmente no se iniciarán por la cola. Los jobs activos no se detienen. NRS Workbench debe permanecer abierto o en la bandeja.'}"
                                   Style="{StaticResource MutedLabel}" TextWrapping="Wrap" Margin="22,7,0,0"/>
                        <CheckBox x:Name="RunnerQueueResourceGuardCheck" Content="{local:Tr Source='Esperar si el PC está demasiado cargado'}"
                                  Foreground="{StaticResource TextBrush}" Margin="22,12,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="42,8,0,0">
                            <TextBlock Text="{local:Tr Source='No iniciar por encima de'}" Style="{StaticResource MutedLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="CPU" Style="{StaticResource MutedLabel}" VerticalAlignment="Center"/>
                            <TextBox x:Name="RunnerQueueCpuThresholdText" Width="54" Padding="7,4" Margin="7,0,4,0" HorizontalContentAlignment="Right"/>
                            <TextBlock Text="%" Style="{StaticResource MutedLabel}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock Text="RAM" Style="{StaticResource MutedLabel}" VerticalAlignment="Center"/>
                            <TextBox x:Name="RunnerQueueMemoryThresholdText" Width="54" Padding="7,4" Margin="7,0,4,0" HorizontalContentAlignment="Right"/>
                            <TextBlock Text="%" Style="{StaticResource MutedLabel}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{local:Tr Source='Si se supera un límite, la cola no inicia ni rota runners nuevos. Los jobs BUSY siguen ejecutándose.'}"
                                   Style="{StaticResource MutedLabel}" TextWrapping="Wrap" Margin="42,7,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="4" Background="#15181C" BorderBrush="#303640" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{local:Tr Source='Notificaciones'}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="NotificationsEnabledCheck" Content="{local:Tr Source='Activar notificaciones de escritorio'}" Foreground="{StaticResource TextBrush}"/>
                        <WrapPanel Margin="20,9,0,0">
                            <CheckBox x:Name="NotifyJobStartedCheck" Content="{local:Tr Source='Job iniciado'}" Foreground="{StaticResource TextBrush}" Margin="0,0,22,0"/>
                            <CheckBox x:Name="NotifyJobCompletedCheck" Content="{local:Tr Source='Job finalizado'}" Foreground="{StaticResource TextBrush}" Margin="0,0,22,0"/>
                            <CheckBox x:Name="NotifyRunnerIssuesCheck" Content="{local:Tr Source='Errores del runner'}" Foreground="{StaticResource TextBrush}"/>
                        </WrapPanel>
                        <CheckBox x:Name="NotifyOnlyWhenHiddenCheck" Content="{local:Tr Source='Mostrar avisos solo cuando NRS Workbench no está en primer plano'}" Foreground="{StaticResource TextBrush}" Margin="20,9,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{local:Tr Source='Idioma'}" Style="{StaticResource MutedLabel}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <ComboBox x:Name="LanguageChoice" Width="170" SelectedValuePath="Tag">
                        <ComboBoxItem Content="Español" Tag="es"/>
                        <ComboBoxItem Content="English" Tag="en"/>
                        <ComboBoxItem Content="Català" Tag="ca"/>
                    </ComboBox>
                    <TextBlock Text="{local:Tr Source='Se aplica al reiniciar la aplicación.'}" Style="{StaticResource MutedLabel}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>

                <Border Grid.Row="6" Background="#15181C" BorderBrush="#303640" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{local:Tr Source='Portabilidad'}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="{local:Tr Source='Exporta rutas y preferencias para mover NRS Workbench a otro PC. No incluye credenciales, tokens ni archivos internos de los runners. El archivo sí contiene rutas locales; revísalo antes de compartirlo.'}"
                                       Style="{StaticResource MutedLabel}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{local:Tr Source='Exportar...'}" Style="{StaticResource ToolbarButton}" Padding="10,6" Click="Export_Click"/>
                            <Button Content="{local:Tr Source='Importar...'}" Style="{StaticResource ToolbarButton}" Padding="10,6" Margin="8,0,0,0" Click="Import_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{local:Tr Source='Cancelar'}" Style="{StaticResource ToolbarButton}" Click="Cancel_Click"/>
            <Button Content="{local:Tr Source='Guardar'}" Style="{StaticResource PrimaryToolbarButton}" Margin="0" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
